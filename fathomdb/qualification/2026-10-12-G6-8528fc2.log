======== scripts: ob.sh
#!/usr/bin/env bash
# ob.sh <src> <tgt>: build the --lib test binary (12060, default features); print its path.
set -euo pipefail
export PATH="$HOME/.cargo/bin:$PATH"
cd "$1"
export CUDARC_CUDA_VERSION=12060 CARGO_TARGET_DIR="$2"
cargo test --locked --lib -F cuda-12060 --no-run > "$2.build.log" 2>&1 || { tail -30 "$2.build.log"; exit 2; }
grep -o 'Executable unittests src/lib.rs ([^)]*)' "$2.build.log" | sed 's/.*(//;s/)$//' | tail -1

======== scripts: or.sh
#!/usr/bin/env bash
# or.sh <outdir> <label> <bin> <libtest args...>: one test process, guarded.
set -uo pipefail
out="$1"; label="$2"; bin="$3"; shift 3
mkdir -p "$out"
g(){ echo "tegra=$(head -1 /etc/nv_tegra_release) cuda=$(readlink -f /usr/local/cuda)"; }
G0="$(g)"; echo "$(date -Iseconds) GUARD before $label $G0" >> "$out/guard.log"
t0="$(date -Iseconds)"
env CUDA_DEVICE_ORDER=PCI_BUS_ID CUDA_VISIBLE_DEVICES=0 CUDARC_CUDA_VERSION=12060 \
  timeout 1800 "$bin" "$@" > "$out/$label.log" 2>&1
st=$?
res="$(grep -E '^test result' "$out/$label.log" | head -1 | sed 's/^test result: //')"
printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$label" "$st" "$t0" "$(date -Iseconds)" "${res:-NORESULT}" "$bin $*" >> "$out/runs.tsv"
G1="$(g)"; echo "$(date -Iseconds) GUARD after $label $G1" >> "$out/guard.log"
[ "$G1" = "$G0" ] || { echo "GUARD CHANGED: $G1" | tee -a "$out/guard.log"; exit 3; }
echo "$label exit=$st ${res:-NORESULT}"

======== scripts: pt.sh
#!/usr/bin/env bash
# pt.sh <label> <bin> <k>: every --lib test as its own process, k times, guarded (or.sh).
# Writes pt-<label>-<i>.tsv: name, kind (main|ignored), exit status, libtest result word.
set -uo pipefail
cd ~/fdb-g6-fix
L="$1"; B="$2"; K="$3"; out="out-$L"
"$B" --list 2>/dev/null | sed -n 's/: test$//p' | sort > "$L-all.txt"
"$B" --list --ignored 2>/dev/null | sed -n 's/: test$//p' | sort > "$L-ign.txt"
comm -23 "$L-all.txt" "$L-ign.txt" > "$L-main.txt"
for i in $(seq 1 "$K"); do
  tsv="pt-$L-$i.tsv"; : > "$tsv"
  one(){ local kind=$1 t=$2; shift 2
    local lab="pt$i-$kind-$t"
    ./or.sh "$out" "$lab" "$B" --exact "$t" "$@" --test-threads=1 > /dev/null || { [ $? = 3 ] && exit 3; }
    local st res; st=$(awk -F'\t' -v l="$lab" '$1==l{s=$2} END{print s}' "$out/runs.tsv")
    res=$(grep -E '^test result' "$out/$lab.log" | head -1 | sed 's/test result: //;s/\. .*//')
    printf '%s\t%s\t%s\t%s\n' "$t" "$kind" "$st" "${res:-NORESULT}" >> "$tsv"; }
  while read -r t; do one main "$t"; done < "$L-main.txt"
  while read -r t; do one ignored "$t" --ignored; done < "$L-ign.txt"
  echo "k=$i: $(awk -F'\t' '$3!=0' "$tsv" | wc -l) nonzero of $(wc -l < "$tsv")"
done

